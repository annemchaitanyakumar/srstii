@import "tailwindcss" source(none);
@source "../src";
@import "tw-animate-css";

@custom-variant dark (&:is(.dark *));

/*
 * SRSTI — "Liquid Gold & Heritage Apothecary"
 * Light = Sunlit Harvest, Dark = Midnight Press. All colors are oklch tokens.
 */

@theme inline {
  --font-display: "EB Garamond", "ITC Garamond", "Cormorant Garamond", Garamond, Georgia, serif;
  --font-sans: "DM Sans", "Apercu", "Plus Jakarta Sans", ui-sans-serif, system-ui, sans-serif;
  --font-mono: "DM Mono", "GT Alpina Typewriter", monospace;

  --radius-sm: calc(var(--radius) - 4px);
  --radius-md: calc(var(--radius) - 2px);
  --radius-lg: var(--radius);
  --radius-xl: calc(var(--radius) + 4px);
  --radius-2xl: calc(var(--radius) + 8px);
  --radius-3xl: calc(var(--radius) + 12px);
  --radius-4xl: calc(var(--radius) + 16px);

  --color-background: var(--background);
  --color-foreground: var(--foreground);
  --color-card: var(--card);
  --color-card-foreground: var(--card-foreground);
  --color-popover: var(--popover);
  --color-popover-foreground: var(--popover-foreground);
  --color-primary: var(--primary);
  --color-primary-foreground: var(--primary-foreground);
  --color-secondary: var(--secondary);
  --color-secondary-foreground: var(--secondary-foreground);
  --color-muted: var(--muted);
  --color-muted-foreground: var(--muted-foreground);
  --color-accent: var(--accent);
  --color-accent-foreground: var(--accent-foreground);
  --color-destructive: var(--destructive);
  --color-destructive-foreground: var(--destructive-foreground);
  --color-border: var(--border);
  --color-input: var(--input);
  --color-ring: var(--ring);
  --color-ring-offset-background: var(--background);

  --color-gold: var(--gold);
  --color-gold-ink: var(--gold-ink);
  --color-gold-glow: var(--gold-glow);
  --color-linen: var(--linen);
  --color-glass: var(--glass);
  --color-glass-border: var(--glass-border);
  --color-veil: var(--veil);

  --color-chart-1: var(--chart-1);
  --color-chart-2: var(--chart-2);
  --color-chart-3: var(--chart-3);
  --color-chart-4: var(--chart-4);
  --color-chart-5: var(--chart-5);
  --color-sidebar: var(--sidebar);
  --color-sidebar-foreground: var(--sidebar-foreground);
  --color-sidebar-primary: var(--sidebar-primary);
  --color-sidebar-primary-foreground: var(--sidebar-primary-foreground);
  --color-sidebar-accent: var(--sidebar-accent);
  --color-sidebar-accent-foreground: var(--sidebar-accent-foreground);
  --color-sidebar-border: var(--sidebar-border);
  --color-sidebar-ring: var(--sidebar-ring);

  --shadow-glass: var(--shadow-glass-v);
  --shadow-gold: var(--shadow-gold-v);
  --ease-silk: cubic-bezier(0.22, 1, 0.36, 1);
}

/* Sage Mist, Forest Ink & Pearl Jade */
:root {
  --radius: 1rem;
  --background: #b9d6a8;
  --foreground: #0e1f10;
  --linen: rgba(236, 247, 228, 0.85);
  --card: rgba(242, 250, 235, 0.72);
  --card-foreground: #0e1f10;
  --popover: rgba(242, 250, 235, 0.92);
  --popover-foreground: #0e1f10;
  --primary: #0e1f10;
  --primary-foreground: #f2faeb;
  --secondary: rgba(214, 236, 202, 0.75);
  --secondary-foreground: #0e1f10;
  --muted: rgba(214, 236, 202, 0.65);
  --muted-foreground: #2d4530;
  --accent: #1e4a26;
  --accent-foreground: #f2faeb;
  --gold: #2a6a38;
  --gold-ink: #184622;
  --gold-glow: rgba(42, 106, 56, 0.35);
  --glass: rgba(242, 250, 235, 0.65);
  --glass-border: rgba(14, 31, 16, 0.14);
  --veil: rgba(242, 250, 235, 0.85);
  --destructive: #dc2626;
  --destructive-foreground: #fff;
  --border: rgba(14, 31, 16, 0.14);
  --input: rgba(14, 31, 16, 0.14);
  --ring: #2a6a38;
  --shadow-glass-v: 0 25px 50px -20px rgba(14, 31, 16, 0.12), inset 0 1px 0 rgba(255, 255, 255, 0.7);
  --shadow-gold-v: 0 15px 35px -10px rgba(42, 106, 56, 0.35);
  --gradient-gold: linear-gradient(135deg, #1b4d25, #2d733b 50%, #52a363);
  --gradient-gold-text: linear-gradient(135deg, #0e1f10, #1b4d25 45%, #2d733b);
  --chart-1: #2a6a38;
  --chart-2: #3e884f;
  --chart-3: #52a363;
  --chart-4: #7ac088;
  --chart-5: #a7e8b3;
  --sidebar: rgba(236, 247, 228, 0.95);
  --sidebar-foreground: #0e1f10;
  --sidebar-primary: #0e1f10;
  --sidebar-primary-foreground: #f2faeb;
  --sidebar-accent: rgba(214, 236, 202, 0.75);
  --sidebar-accent-foreground: #0e1f10;
  --sidebar-border: rgba(14, 31, 16, 0.12);
  --sidebar-ring: #2a6a38;
}

/* Midnight Forest */
.dark {
  --background: #08120a;
  --foreground: #eef7eb;
  --linen: #102114;
  --card: rgba(16, 33, 20, 0.75);
  --card-foreground: #eef7eb;
  --popover: rgba(14, 28, 17, 0.92);
  --popover-foreground: #eef7eb;
  --primary: #eef7eb;
  --primary-foreground: #08120a;
  --secondary: #172e1b;
  --secondary-foreground: #eef7eb;
  --muted: #172e1b;
  --muted-foreground: #8fa88c;
  --accent: #52a363;
  --accent-foreground: #08120a;
  --gold: #52a363;
  --gold-ink: #7ac088;
  --gold-glow: rgba(82, 163, 99, 0.45);
  --glass: rgba(16, 33, 20, 0.65);
  --glass-border: rgba(82, 163, 99, 0.22);
  --veil: rgba(8, 18, 10, 0.88);
  --destructive: #ef4444;
  --destructive-foreground: #fff;
  --border: rgba(82, 163, 99, 0.2);
  --input: rgba(82, 163, 99, 0.2);
  --ring: #52a363;
  --shadow-glass-v: 0 30px 60px -25px rgba(0, 0, 0, 0.7), inset 0 1px 0 rgba(255, 255, 255, 0.08);
  --shadow-gold-v: 0 15px 40px -10px rgba(82, 163, 99, 0.35);
  --gradient-gold: linear-gradient(135deg, #7ac088, #52a363 50%, #2d733b);
  --gradient-gold-text: linear-gradient(135deg, #ffffff, #bbf7c5 45%, #7ac088);
  --sidebar: #102114;
  --sidebar-foreground: #eef7eb;
  --sidebar-primary: #52a363;
  --sidebar-primary-foreground: #08120a;
  --sidebar-accent: #172e1b;
  --sidebar-accent-foreground: #eef7eb;
  --sidebar-border: rgba(82, 163, 99, 0.2);
  --sidebar-ring: #52a363;
}

/* Mood-specific dynamic theme overrides (Saute: Grey, Ayurvedic Ritual: Chocolate) */
[data-mood="saute"] {
  --gold: #525b62;
  --gold-ink: #3b4249;
  --gold-glow: rgba(82, 91, 98, 0.35);
  --gradient-gold: linear-gradient(135deg, #374151, #4b5563 50%, #6b7280);
  --gradient-gold-text: linear-gradient(135deg, #111827, #374151 50%, #4b5563);
  --accent: #4b5563;
}

[data-mood="ritual"] {
  --gold: #6b3e26;
  --gold-ink: #4f2916;
  --gold-glow: rgba(107, 62, 38, 0.35);
  --gradient-gold: linear-gradient(135deg, #3e1f10, #5a2e19 50%, #7c4428);
  --gradient-gold-text: linear-gradient(135deg, #241108, #3e1f10 50%, #5a2e19);
  --accent: #5a2e19;
}

[data-mood="water"] {
  --gold: #1b6b80;
  --gold-ink: #134e5e;
  --gold-glow: rgba(27, 107, 128, 0.35);
  --gradient-gold: linear-gradient(135deg, #0f3d49, #1b6b80 50%, #2ba0be);
  --gradient-gold-text: linear-gradient(135deg, #082229, #0f3d49 50%, #1b6b80);
  --accent: #1b6b80;
}

@layer base {
  * {
    border-color: var(--color-border);
  }
  html {
    background-color: #b9d6a8;
    color-scheme: light;
    -webkit-text-size-adjust: 100%;
  }
  html.dark {
    background-color: #08120a;
    color-scheme: dark;
  }
  html.lenis,
  html.lenis body {
    height: auto;
  }
  .lenis.lenis-smooth {
    scroll-behavior: auto !important;
  }
  body {
    background-color: transparent;
    color: var(--color-foreground);
    font-family: var(--font-sans);
    -webkit-font-smoothing: antialiased;
    overflow-x: clip;
  }
  ::selection {
    background: var(--gold);
    color: var(--primary);
  }
  :focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 3px;
  }
}

/* Smooth cross-fade for theme switch (View Transitions where supported) */
::view-transition-old(root),
::view-transition-new(root) {
  animation: none;
  mix-blend-mode: normal;
}
html.theme-fade,
html.theme-fade * {
  transition:
    background-color 0.6s var(--ease-silk),
    color 0.6s var(--ease-silk),
    border-color 0.6s var(--ease-silk) !important;
}

@utility font-display {
  font-family: var(--font-display);
  font-feature-settings: "liga", "dlig";
  letter-spacing: -0.025em;
}

@utility font-mono {
  font-family: var(--font-mono);
}

@utility eyebrow {
  font-family: var(--font-mono);
  font-size: 0.74rem;
  font-weight: 500;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--gold-ink);
}

@utility text-gold-gradient {
  background: var(--gradient-gold-text);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

@utility bg-gold-gradient {
  background: var(--gradient-gold);
}

@utility glass-panel {
  background: var(--glass);
  border: 1px solid var(--glass-border);
  box-shadow: var(--shadow-glass);
  backdrop-filter: blur(18px) saturate(1.2);
  -webkit-backdrop-filter: blur(18px) saturate(1.2);
}

@utility veil {
  background: linear-gradient(
    to bottom,
    transparent,
    var(--veil) 12%,
    var(--veil) 88%,
    transparent
  );
}

@utility grain {
  position: relative;
  &::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.07;
    mix-blend-mode: multiply;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
  }
}

/* Liquid-fill CTA: a slow-rotating rounded blob rises like poured oil. */
@property --liquid-y {
  syntax: "<percentage>";
  inherits: false;
  initial-value: 30%;
}

@utility liquid-btn {
  position: relative;
  isolation: isolate;
  overflow: hidden;
  &::before {
    content: "";
    position: absolute;
    left: 50%;
    top: 100%;
    width: 260%;
    aspect-ratio: 1;
    border-radius: 42%;
    background: var(--gradient-gold);
    --liquid-y: 30%;
    transform: translate(-50%, var(--liquid-y)) rotate(0deg);
    transition: --liquid-y 0.9s var(--ease-silk);
    animation: liquid-spin 7s linear infinite;
    z-index: -1;
  }
  &:hover::before,
  &:focus-visible::before {
    --liquid-y: -48%;
  }
}

@keyframes liquid-spin {
  to {
    transform: translate(-50%, var(--liquid-y)) rotate(360deg);
  }
}

@keyframes ripple-out {
  from {
    transform: translate(-50%, -50%) scale(0);
    opacity: 0.55;
  }
  to {
    transform: translate(-50%, -50%) scale(1);
    opacity: 0;
  }
}

@utility gold-ripple {
  position: absolute;
  width: 220%;
  aspect-ratio: 1;
  border-radius: 9999px;
  pointer-events: none;
  background: radial-gradient(circle, oklch(0.82 0.13 82 / 0.5), oklch(0.705 0.12 78.6 / 0.15) 40%, transparent 65%);
  animation: ripple-out 1.1s var(--ease-silk) forwards;
}

@keyframes drop-pulse {
  0%,
  100% {
    transform: translateY(0) scale(1);
  }
  50% {
    transform: translateY(2px) scale(1.06);
  }
}

@utility animate-drop {
  animation: drop-pulse 2.4s ease-in-out infinite;
}

@keyframes slow-spin {
  to {
    transform: rotate(360deg);
  }
}

@utility animate-slow-spin {
  animation: slow-spin 40s linear infinite;
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}
